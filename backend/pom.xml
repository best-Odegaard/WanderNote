    <modules>
        <module>gkv-common</module>
        <module>gkv-pojo</module>
        <module>gkv-server</module>
    </modules>
    <properties>
        <!--
          目标运行时是 Java 8（线上服务器只装了 openjdk-1.8）。
          只写 source/target=8 是不够的：本地用 JDK 17 编译时，javac 仍会
          对着 JDK 17 的类库做符号解析，于是 String.strip()（Java 11）、
          List.copyOf()（Java 10）这类方法能编过，一放到 Java 8 上就
          NoSuchMethodError —— 实测已经踩过一次（流式对话线程当场中断，
          正文能流出来但永远等不到 done 事件）。
          release=8 会强制按 Java 8 的 API 校验，把这类问题拦在编译期。
        -->
        <java.version>1.8</java.version>
        <maven.compiler.release>8</maven.compiler.release>
        <mybatis.spring>2.2.0</mybatis.spring>
        <lombok>1.18.20</lombok>
        <fastjson>1.2.76</fastjson>
        <commons.lang>2.6</commons.lang>
        <druid>1.2.1</druid>
        <pagehelper>5.3.2</pagehelper>
        <jsqlparser>4.9</jsqlparser>
        <hutool>5.8.10</hutool>
        <!-- <aliyun.sdk.oss>3.10.2</aliyun.sdk.oss>-->
        <knife4j>3.0.2</knife4j>
        <aspectj>1.9.4</aspectj>
        <jjwt>0.9.1</jjwt>
        <jaxb-api>2.3.1</jaxb-api>
        <!-- poi 3.16 API 过旧（无 CellType 枚举），升级到 Spring Boot 2.7.3 官方管理的 5.2.2 -->
        <poi>5.2.2</poi>
    </properties>

