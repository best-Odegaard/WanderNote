# 环境变量模板 —— 复制为 .env 后填入自己的配置
# 本地开发：.env（已被 .gitignore 忽略，不会提交）
# 生产构建：npm run build:h5 / build:mp-weixin 时读取 .env.production

# 后端 API 地址（本地 Java 后端）
VITE_API_BASE_URL=http://localhost:8080

# 是否使用本地 Mock 数据（后端就绪后设为 false）
VITE_USE_MOCK=false

# 腾讯位置服务 Key —— 内嵌地图绘制行程路线所需
# 申请地址：https://lbs.qq.com/dev/console/key/manage
# 同一把 Key 同时承担 JS API 渲染与 WebService 地理编码：
# - 个人账号下 WebService 会被腾讯拒绝，代码会自动降级走 JS API Geocoder
# - 企业认证后 WebService 自动生效
VITE_MAP_KEY=your-tencent-map-key
VITE_MAP_WS_KEY=your-tencent-map-key
