<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      品牌色：随 App 图标由「紫→深蓝」改为「绿」。
      取值来自新图标边缘带的实测均值，与 drawable/ic_launcher_bg.xml、splash_bg.xml 保持一致。
    -->
    <color name="brand_navy">#479C87</color>
    <color name="brand_purple">#66B29A</color>

    <!--
      styles.xml 里 colorPrimary / colorPrimaryDark / colorAccent 一直引用 @color/colorPrimary 等，
      但本文件此前并未定义——构建能过是靠 AppCompat 自身的同名资源兜底。这里显式定义，消除隐患。
    -->
    <color name="colorPrimary">#14B8A6</color>
    <color name="colorPrimaryDark">#0E9A85</color>
    <color name="colorAccent">#F2B33D</color>

    <!-- 启动页背景 -->
    <color name="splash_background">#479C87</color>
</resources>
