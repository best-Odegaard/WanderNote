<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的背景层：与 App 图标自身的背景渐变同向同色系。
  前景层（ic_launcher_foreground）是整枚图标放大 1.15 倍居中，自带同一份渐变背景，
  所以启动器遮罩产生视差时只露出边缘同色区域，看不到任何白边或接缝。
  取色为 App 图标边缘带的实测均值（原为紫→深蓝，随新图标改为绿）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="#66B29A"
        android:startColor="#479C87"
        android:type="linear" />
</shape>
